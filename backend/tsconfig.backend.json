{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "db/**/*.ts",
    "routes/**/*.ts",
    "controllers/**/*.ts",
    "middleware/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}